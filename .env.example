# ---- LOCO TM CMS environment ----
PORT=8080

# Persistent state (users/sheds/locos/thresholds). On Railway attach a Volume
# and set DATA_DIR to its mount path so data survives redeploys.
DATA_DIR=./data

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_TTL=12h

# Key for the generic /api/v1/ingest route (readings[] batch format)
DATA_API_KEY=himnish_loco_key_2026

# Key for the EXISTING himnish_push.lua RUT200 script — matches its hardcoded
# K value exactly. The script is not modified; only its URL changes at cutover.
PUSH_API_KEY=himnish_rut200_key_2024

# Key for the LIVE, hardware-connected LOCO-TM-CMS v7 vibration pipeline
# (POST /api/data/ingest). Matches loco_push_v14.lua's hardcoded API_KEY
# exactly ("himnish_data_key_2024") — that script is NOT modified, only its
# RAILWAY target URL changes at cutover (same as PUSH_API_KEY above).
VIB_DATA_API_KEY=himnish_data_key_2024

# Vibration alarm thresholds (RMS/Peak, mm/s) — carried over from v7.
CFG_VIB_WARN_RMS=8.0
CFG_VIB_CRIT_RMS=10.0
CFG_VIB_WARN_PEAK=12.0
CFG_VIB_CRIT_PEAK=16.0
# L10 bearing-life model (hours) — carried over from v7.
CFG_BEARING_BASE=50000
CFG_BEARING_LOAD_FACTOR=1.0
CFG_BEARING_SPEED_FACTOR=1.0

# Synthetic data generator (no hardware). Leave false in production.
DEMO_MODE=false
DEMO_SHEDS=2

# RUT200 IP pull poller interval in seconds (0 = disabled) — not used by the
# push-based lua script, kept for any future pull-mode devices.
POLL_INTERVAL=20

# Default thresholds (deg C) — Warning 120 / High 140 / Critical 160
CFG_WARN_TEMP=120
CFG_HIGH_TEMP=140
CFG_CRIT_TEMP=160
CFG_OFFLINE_SECONDS=300

# Optional PostgreSQL/TimescaleDB archive (durable history). Leave unset for
# in-memory + JSON only.
DATABASE_URL=

# Optional SMTP for email alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional SMS provider: log (dry-run) | fast2sms | msg91 | generic
SMS_PROVIDER=log
SMS_API_KEY=
SMS_SENDER=HMNISH
