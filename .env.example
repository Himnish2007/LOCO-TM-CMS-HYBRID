=======
# For generic provider only: URL with {to} {message} {key} placeholders
SMS_URL=
# --- India DLT SMS (recommended for real alerts): SMS_PROVIDER=fast2sms_dlt ---
# SMS_SENDER = your approved 6-letter DLT header (e.g. HMNISH). The three IDs below are the
# Fast2SMS *message IDs* of your approved templates (see SMS_SETUP_DLT.md for the exact texts).
SMS_DLT_TPL_TEMP=
SMS_DLT_TPL_OFFLINE=
SMS_DLT_TPL_BATT=
# Do not SMS the same number again for the same loco+severity within N minutes (0 = no limit)
SMS_REPEAT_MIN=30

# Escalation scan interval (seconds)
ESCALATION_INTERVAL=60

# ---- PostgreSQL / TimescaleDB (optional, recommended for production) ----
# When set, every reading is stored permanently and history survives restarts.
# On Railway: add a PostgreSQL plugin and it provides DATABASE_URL automatically.
DATABASE_URL=
# Hours of recent history to reload into memory on startup
BACKFILL_HOURS=6
# Set to 'require' if your Postgres needs SSL (some external providers do)
PGSSL=

# ---- Optional MQTT ingestion (only if you use an MQTT broker) ----
# When set, the app subscribes and ingests JSON messages alongside HTTP push.
MQTT_URL=
MQTT_TOPIC=himnish/shed/+/readings
MQTT_USERNAME=
MQTT_PASSWORD=

# ---- Data retention (optional) ----
# Purge readings older than N days (0 = keep forever). Needs PostgreSQL.
RETENTION_DAYS=0

# ---- Production hardening (optional) ----
# Redirect http->https (only if your host forwards x-forwarded-proto). Railway
# already serves https, so leave unset unless you specifically need the redirect.
FORCE_HTTPS=

# ---- Optional AI Copilot (LLM) ----
# Set these to enable natural-language answers in the Assistant tab. Any
# OpenAI-compatible chat-completions endpoint works. Without a key, the
# Assistant uses the built-in rule-based logic.
LLM_API_KEY=
LLM_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

# --- Login security (all optional; the defaults are safe) -------------------------------------
# First run ONLY: password for the first "admin" account (10+ chars, 3 kinds of characters).
# Without it the account starts with a public default password and is forced to change it at sign-in.
# ADMIN_INITIAL_PASSWORD=
LOGIN_MAX_FAILS=5          # wrong passwords before an account is locked
LOGIN_LOCK_MINUTES=15      # first lock; doubles at each repeat, at most 24 h
LOGIN_IP_MAX_FAILS=30      # FAILED sign-ins per address per 15 min (successful ones never count)
LOGIN_PARALLEL=4           # password checks at the same moment (others wait in line)
JWT_TTL=8h                 # how long one sign-in lasts
# Roles that MUST use two-step verification (comma separated), e.g. super_admin. Turn on only after
# every such user has set it up, and keep a second admin as a spare.
# REQUIRE_2FA_ROLES=super_admin
API_RATE_MAX=3000          # dashboard API calls per minute per office address
