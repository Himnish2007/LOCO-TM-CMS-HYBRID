# Ingestion key used by every Himnish LTE module / RUT200 push. This is the LEGACY shared key —
# each field device now gets its own unique key automatically the first time it pulls its config
# (Admin -> Field Devices), so this value is only used by devices that have not migrated yet.
DATA_API_KEY=himnish_shed_key_2025
# Shared key a field RUT uses to pull its own config before it has (or to re-pull) its per-device key.
BOOTSTRAP_KEY=himnish_bootstrap_2025

# Once every field device has its own per-device key (Admin -> Field Devices shows each device's
# status) AND you have rotated DATA_API_KEY/BOOTSTRAP_KEY away from the defaults above, set this to
# true so the server refuses the old shared defaults outright instead of only warning about them.
STRICT_SECURITY=false

# API docs (/docs, /openapi.json) are hidden (404) unless BOTH of these are set, then protected with
# HTTP Basic Auth. Leave blank to keep the docs off entirely.
DOCS_USER=
DOCS_PASSWORD=
