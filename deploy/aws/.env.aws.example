# Copy to /home/ubuntu/loco-tm-cms/.env on the LOCO instance and fill in. Never commit the real file.
# EVERY secret below must be DIFFERENT from the emu.himinsights.in server so the two systems can never clash.
NODE_ENV=production
PORT=3100
DEMO_MODE=false
STRICT_SECURITY=true      # refuse to start with default secrets / no database
DATA_DIR=/var/lib/loco-tm

# ---- own database (separate from EMU) -------------------------------------------------------
# Same RDS server is fine as long as it is a SEPARATE database + user:  loco_tm / loco_user
DATABASE_URL=postgresql://loco_user:CHANGE_ME@database-1.c9wow4o44b1i.ap-south-1.rds.amazonaws.com:5432/loco_tm
PGSSL=require
RETENTION_DAYS=0
CFG_LOG_INTERVAL_SECONDS=600

# ---- secrets (generate each:  openssl rand -hex 32) -----------------------------------------
JWT_SECRET=
DATA_API_KEY=
BOOTSTRAP_KEY=
ADMIN_INITIAL_PASSWORD=ChangeMe-LocoAdmin#2026

# ---- RUT200 keys: must match the scripts already on the locos, do NOT change -------------------
PUSH_API_KEY=himnish_rut200_key_2024
VIB_DATA_API_KEY=himnish_data_key_2024

# ---- links in emailed reports ---------------------------------------------------------------
REPORT_BASE_URL=https://loco.himinsights.in

# ---- email alerts (same mailbox as EMU is fine) ----------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=piyush@himnishindia.com
SMTP_PASSWORD=
SMTP_FROM=piyush@himnishindia.com

# ---- SMS alerts, India DLT via Fast2SMS ------------------------------------------------------
SMS_PROVIDER=fast2sms_dlt
SMS_API_KEY=
SMS_SENDER=HIMEMU
SMS_DLT_TPL_TEMP=
SMS_DLT_TPL_OFFLINE=
SMS_DLT_TPL_BATT=

# ---- docs page (optional, hidden unless both set) --------------------------------------------
DOCS_USER=
DOCS_PASSWORD=
